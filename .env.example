# --- Google OAuth client (see README "Google Cloud setup") -------------------
# One client serves every user of your deployment. Your users never create one.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match EXACTLY one of the "Authorised redirect URIs" on that client.
# Defaults to http://localhost:<PORT>/api/auth/callback when left blank.
OAUTH_REDIRECT_URI=http://localhost:5175/api/auth/callback

# --- Server -----------------------------------------------------------------
PORT=5175

# Interface to bind. Loopback by default so nothing is exposed accidentally.
# Set 0.0.0.0 when running behind a reverse proxy or in a container.
HOST=127.0.0.1

# Where the browser is sent after sign-in.
# Dev = the Vite dev server. In production leave blank to use the server itself.
WEB_ORIGIN=http://localhost:5174

# --- Security ---------------------------------------------------------------
# REQUIRED IN PRODUCTION. Encrypts Google refresh tokens at rest (AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In development one is generated into data/encryption.key automatically.
# Changing it invalidates every stored token - users must reconnect.
ENCRYPTION_KEY=

# How long a signed-in browser session lasts.
SESSION_TTL_DAYS=30

# Send session cookies only over HTTPS. Implied when NODE_ENV=production.
SECURE_COOKIES=

# The in-app setup panel writes to .env, so it is loopback-only and is disabled
# outright when NODE_ENV=production. Set 0 to disable it in development too.
ALLOW_SETUP_UI=

# --- Database ---------------------------------------------------------------
# Leave blank for local development: a SQLite file is used at data/flotilla.db.
# Set it to share an existing Postgres server instead (Render, Neon, Supabase).
DATABASE_URL=

# With a dedicated database (the recommended setup, see
# server/sql/setup-postgres.sql) leave this as public. Change it only when
# sharing a database with another app, where this app's users and sessions
# tables would otherwise collide.
DATABASE_SCHEMA=public

# TLS is enabled automatically for any non-local host, which is what you want:
# managed Postgres requires it on the internal URL as well as the external one.
# Set 0 only for a database on localhost.
DATABASE_SSL=

# Keep this small on a shared instance so other applications are not starved.
DATABASE_POOL_MAX=5

# --- Behaviour --------------------------------------------------------------
# Seconds between live-viewer refreshes (server-side cache TTL, per user).
REALTIME_TTL=15
# Seconds to cache historical reports, per user.
STATS_TTL=300

# MOCK=1 gives visitors a local demo account with generated data and no Google
# setup. A real connection always takes precedence. Development only.
MOCK=
